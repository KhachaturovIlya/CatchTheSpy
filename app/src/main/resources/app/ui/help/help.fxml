<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="app.ui.main.HelpController"
           styleClass="help-root">

    <VBox spacing="14" prefWidth="720" maxWidth="720" styleClass="card">
        <Label text="Help" styleClass="help-title"/>

        <Label wrapText="true" maxWidth="Infinity" styleClass="default-text"
               text="Данная программа предназначена для обнаружения шпионов. В её функционал входит:"/>

        <Label wrapText="true" maxWidth="Infinity" styleClass="default-text, help-item"
               text="1. Выгрузка файлов из различных форматов в локальную БД."/>
        <Label wrapText="true" maxWidth="Infinity" styleClass="default-text, help-item"
               text="2. Обработка информации и выдача списка подозрительных личностей."/>
        <Label wrapText="true" maxWidth="Infinity" styleClass="default-text, help-item"
               text="3. Дальнейшие запросы в БД для проведения исследования данных."/>
    </VBox>

    <Button text="✕" onAction="#onClose"
            cancelButton="true" styleClass="close-button"
            StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="12" right="12"/>
        </StackPane.margin>
    </Button>
</StackPane>