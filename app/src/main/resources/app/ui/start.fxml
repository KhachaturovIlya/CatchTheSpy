<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="app.ui.StartController"
      alignment="CENTER" spacing="48" styleClass="start-root">

    <VBox alignment="CENTER" spacing="10">
        <Label text="Catch The Spy (v 1.0.0)" styleClass="title"/>
        <Label text="All rights are owned by 'AI NKVD NASLEDIE'"
               styleClass="subtitle"/>
    </VBox>

    <Region prefHeight="200"/>

    <VBox alignment="CENTER" spacing="14">
        <Button text="Begin scanning" onAction="#onStart"
                prefWidth="500" prefHeight="100"
                defaultButton="true" styleClass="primary"/>
        <Button text="Help" onAction="#onHelp"
                prefWidth="500" prefHeight="100"
                styleClass="secondary"/>
        <Button text="Exit" onAction="#onExit"
                prefWidth="500" prefHeight="100"
                cancelButton="true" styleClass="secondary"/>
    </VBox>
</VBox>